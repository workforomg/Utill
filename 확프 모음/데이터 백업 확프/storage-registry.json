{
  "schemaVersion": 2,
  "revision": "2026-09-03-2",
  "sites": {
    "https://crack.wrtn.ai": {
      "extensions": [
        {
          "id": "erie-crack-lore-injector",
          "localStorage": {
            "keys": [],
            "prefixes": [
              "lore-",
              "speech-refiner-"
            ]
          },
          "sessionStorage": {
            "keys": [
              "lore-router-chat-hint-shown"
            ],
            "prefixes": [
